{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bit_pouch",
  "version": "0.7.0",
  "identifier": "top.ihomy.bitpouch",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "bit_pouch · 比特口袋",
        "width": 1200,
        "height": 820,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A pocket toolbox for builders",
    "longDescription": "bit_pouch is a fast, local-first, plugin-based toolbox for developers. Desktop and mobile share one plugin core."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3NEVDRjA1MEMzNkNDMkUKUldRdXpEWU1CYzlPdDZ3a0lacFlHRnRvTWdKRDNLRzhHcElHbHB2V2hCcjJQd25WLytUSTZzN1oK",
      "requireSignedVersion": true,
      "endpoints": [
        "https://ihomy.top/files/bit_pouch/updates/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
