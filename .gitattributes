* text=auto
*.vue text eol=crlf
*.ts text eol=crlf
*.js text eol=crlf
*.mjs text eol=crlf
*.json text eol=crlf
*.md text eol=crlf
*.css text eol=crlf
*.rs text eol=lf
*.toml text eol=lf
# 服务器脚本 / systemd / CI 必须保持 LF，CRLF 会让 Linux 上的 bash 报 bad interpreter
*.sh text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.yml text eol=lf
*.png binary
*.ico binary
*.icns binary
